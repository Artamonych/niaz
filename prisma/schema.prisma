// Мини-CRM завода. SQLite на тестовом домене; на бою меняется provider на
// postgresql без правок моделей — типы полей выбраны совместимые.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fio          String
  phone        String?
  role         String   @default("MANAGER")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  /// Личный токен для привязки Telegram: ссылка t.me/<бот>?start=<токен>.
  /// По нему бот понимает, чьи заявки слать в этот чат.
  tgToken String? @unique

  leads    Lead[]
  clients  Client[]
  events   Event[]
  tgChats  TelegramChat[]
}

/// Стадия канбана. Список стадий в прототипе редактируемый, поэтому хранится строкой.
model Stage {
  id     String @id @default(cuid())
  key    String @unique
  title  String
  accent String
  order  Int

  leads Lead[]
}

model Lead {
  id      Int    @id @default(autoincrement())
  /// Человекочитаемый номер заявки — его называют в переписке с заказчиком.
  num     String @unique
  fio     String
  phone   String
  email   String?
  org     String?
  inn     String?
  comment String?
  /// Что запрашивали: категория каталога или конкретное исполнение.
  subject String?
  /// Страница, с которой пришла заявка — нужна для аналитики заявок (§12 ТЗ).
  sourceUrl String?
  source    String @default("Форма на сайте")

  stageId String
  stage   Stage  @relation(fields: [stageId], references: [id])

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id])

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Корзина: заявка — персональные данные и история работы с клиентом, поэтому
  /// удаление обратимо. Пока дата стоит, заявки нет ни на доске, ни в счётчиках.
  deletedAt DateTime?
  /// Кто удалил — строкой, чтобы подпись пережила удаление учётной записи.
  deletedBy String?

  events Event[]

  @@index([stageId])
  @@index([createdAt])
  @@index([deletedAt])
}

model Client {
  id      String  @id @default(cuid())
  name    String
  inn     String?
  kpp     String?
  city    String?
  contact String?
  phone   String?
  email   String?
  status  String  @default("В работе")
  comment String?
  source  String?

  // Банковские реквизиты — тендерным закупкам они нужны в карточке контрагента.
  bankAccount String?
  bankBik     String?
  bankName    String?
  bankCorr    String?
  address     String?

  managerId String?
  manager   User?   @relation(fields: [managerId], references: [id])

  createdAt DateTime @default(now())

  leads  Lead[]
  events Event[]
}

model Service {
  id    String @id @default(cuid())
  name  String @unique
  price Int    @default(0)
}

/// Новость завода из CRM. Живёт по адресу /novosti/<slug>/ — новости донора
/// лежат в статичной выгрузке, их адреса (§6.1 ТЗ) эта таблица не трогает.
model NewsPost {
  id      String  @id @default(cuid())
  slug    String  @unique
  title   String
  excerpt String
  /// Простой текст: абзацы разделяются пустой строкой, разметки нет.
  body     String
  videoUrl String?
  status   String  @default("DRAFT") // DRAFT | PUBLISHED
  /// Редактируется: по ней строится лента, можно поставить задним числом.
  publishedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos NewsPhoto[]

  @@index([status, publishedAt])
}

/// Фото новости. Файл лежит в томе загрузок, в базе — только его имя.
model NewsPhoto {
  id     String   @id @default(cuid())
  postId String
  post   NewsPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  /// uuid.jpg — имя выдаёт сервер, пользовательский ввод в путь не попадает.
  file    String  @unique
  width   Int
  height  Int
  isCover Boolean @default(false)
  order   Int     @default(0)

  createdAt DateTime @default(now())

  @@index([postId])
}

/// Чат Telegram, куда бот шлёт заявки. Подключается кодом доступа
/// (TG_JOIN_CODE) — заявки несут ФИО и телефоны, случайный человек, нашедший
/// бота, их получать не должен. Отключается в настройках CRM или удалением
/// бота из чата.
model TelegramChat {
  /// id чата строкой: у групп он отрицательный и больше 32 бит.
  id    String @id
  type  String // private | group | supergroup
  title String
  /// Чей это чат. null — общий чат отдела (подключён общим кодом), получает
  /// все заявки. С владельцем — личный: состав заявок зависит от его роли.
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Служебное состояние бота: смещение опроса, имя бота, неделя последнего отчёта.
model BotState {
  key   String @id
  value String
}

/// Очередь писем. Свой сервис отправки шлёт напрямую на почтовые узлы
/// получателей, а те часто отвечают временным отказом («попробуйте позже»)
/// — без очереди такое письмо потерялось бы молча. По записи на адрес:
/// отказ одному получателю не задерживает остальных.
model MailMessage {
  id      String @id @default(cuid())
  to      String
  subject String
  body    String
  /// pending | sent | failed
  status   String @default("pending")
  attempts Int    @default(0)
  /// Последний ответ сервера получателя — по нему разбирают, почему не дошло.
  lastError String?
  /// Когда пробовать снова: временные отказы переносятся, а не теряются.
  nextTryAt DateTime @default(now())
  sentAt    DateTime?
  createdAt DateTime @default(now())

  @@index([status, nextTryAt])
  @@index([createdAt])
}

/// Журнал действий: кто что изменил и удалил. Отдельно от ленты событий —
/// та привязана к заявке или контрагенту и видна менеджерам, а здесь и то,
/// у чего заявки нет: сотрудники, новости, услуги, подключение чатов.
/// Читает администратор (право audit:view).
model AuditLog {
  id String @id @default(cuid())
  /// Ключ действия: lead.stage, client.update, employee.block и т. п.
  action String
  /// Что затронуто: «Заявка #1042», «Сотрудник Иванов» — в готовом виде,
  /// чтобы запись оставалась читаемой после удаления самой сущности.
  target String
  /// Подробности: что именно изменилось.
  details String?
  /// Кто действовал. Автор сохраняется строкой: сотрудника могут удалить.
  actorId   String?
  actorName String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

/// Лента событий: системные записи о смене стадии и комментарии менеджеров.
model Event {
  id   String @id @default(cuid())
  kind String @default("comment") // comment | system
  text String

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id])
  /// Подпись автора на момент события — сохраняется, даже если сотрудника удалили.
  authorName String

  leadId Int?
  lead   Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([clientId])
}
