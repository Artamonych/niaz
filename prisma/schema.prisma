// Мини-CRM завода. SQLite на тестовом домене; на бою меняется provider на
// postgresql без правок моделей — типы полей выбраны совместимые.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fio          String
  phone        String?
  role         String   @default("MANAGER")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  leads    Lead[]
  clients  Client[]
  events   Event[]
}

/// Стадия канбана. Список стадий в прототипе редактируемый, поэтому хранится строкой.
model Stage {
  id     String @id @default(cuid())
  key    String @unique
  title  String
  accent String
  order  Int

  leads Lead[]
}

model Lead {
  id      Int    @id @default(autoincrement())
  /// Человекочитаемый номер заявки — его называют в переписке с заказчиком.
  num     String @unique
  fio     String
  phone   String
  email   String?
  org     String?
  inn     String?
  comment String?
  /// Что запрашивали: категория каталога или конкретное исполнение.
  subject String?
  /// Страница, с которой пришла заявка — нужна для аналитики заявок (§12 ТЗ).
  sourceUrl String?
  source    String @default("Форма на сайте")

  stageId String
  stage   Stage  @relation(fields: [stageId], references: [id])

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id])

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events Event[]

  @@index([stageId])
  @@index([createdAt])
}

model Client {
  id      String  @id @default(cuid())
  name    String
  inn     String?
  kpp     String?
  city    String?
  contact String?
  phone   String?
  email   String?
  status  String  @default("В работе")
  comment String?
  source  String?

  // Банковские реквизиты — тендерным закупкам они нужны в карточке контрагента.
  bankAccount String?
  bankBik     String?
  bankName    String?
  bankCorr    String?
  address     String?

  managerId String?
  manager   User?   @relation(fields: [managerId], references: [id])

  createdAt DateTime @default(now())

  leads  Lead[]
  events Event[]
}

model Service {
  id    String @id @default(cuid())
  name  String @unique
  price Int    @default(0)
}

/// Новость завода из CRM. Живёт по адресу /novosti/<slug>/ — новости донора
/// лежат в статичной выгрузке, их адреса (§6.1 ТЗ) эта таблица не трогает.
model NewsPost {
  id      String  @id @default(cuid())
  slug    String  @unique
  title   String
  excerpt String
  /// Простой текст: абзацы разделяются пустой строкой, разметки нет.
  body     String
  videoUrl String?
  status   String  @default("DRAFT") // DRAFT | PUBLISHED
  /// Редактируется: по ней строится лента, можно поставить задним числом.
  publishedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos NewsPhoto[]

  @@index([status, publishedAt])
}

/// Фото новости. Файл лежит в томе загрузок, в базе — только его имя.
model NewsPhoto {
  id     String   @id @default(cuid())
  postId String
  post   NewsPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  /// uuid.jpg — имя выдаёт сервер, пользовательский ввод в путь не попадает.
  file    String  @unique
  width   Int
  height  Int
  isCover Boolean @default(false)
  order   Int     @default(0)

  createdAt DateTime @default(now())

  @@index([postId])
}

/// Чат Telegram, куда бот шлёт заявки. Подключается кодом доступа
/// (TG_JOIN_CODE) — заявки несут ФИО и телефоны, случайный человек, нашедший
/// бота, их получать не должен. Отключается в настройках CRM или удалением
/// бота из чата.
model TelegramChat {
  /// id чата строкой: у групп он отрицательный и больше 32 бит.
  id        String   @id
  type      String // private | group | supergroup
  title     String
  createdAt DateTime @default(now())
}

/// Служебное состояние бота: смещение опроса, имя бота, неделя последнего отчёта.
model BotState {
  key   String @id
  value String
}

/// Лента событий: системные записи о смене стадии и комментарии менеджеров.
model Event {
  id   String @id @default(cuid())
  kind String @default("comment") // comment | system
  text String

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id])
  /// Подпись автора на момент события — сохраняется, даже если сотрудника удалили.
  authorName String

  leadId Int?
  lead   Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([clientId])
}
