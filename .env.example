# Домен тестового стенда, без протокола
SITE_DOMAIN=example.ru

# Полный адрес: попадает в canonical и sitemap
NEXT_PUBLIC_SITE_URL=https://example.ru

# Ключ подписи сессии CRM. Свой, длинный:
#   openssl rand -base64 48
AUTH_SECRET=

# На тестовом стенде НЕ ставить true — иначе стенд уедет в поисковый индекс
SITE_INDEXABLE=false

# Первый вход в CRM. Пароль сменить сразу после входа.
ADMIN_EMAIL=admin@niaz.ru
ADMIN_PASSWORD=
ADMIN_FIO=Администратор

# Домен CRM, если он отдельный (например crm.example.ru). Пусто — сайт и CRM
# работают на одном домене. Задан — CRM отвечает только на нём, остальные
# адреса уходят 301 на сайт, а на домене сайта адреса CRM отдают 404 (proxy.ts).
CRM_HOST=

# Каталог фото новостей. В контейнере задаётся compose-файлом, локально по
# умолчанию ./uploads.
# UPLOADS_DIR=./uploads

# Бот заявок в Telegram (lib/telegram.ts). Пусто — бот выключен, заявки
# только в CRM. VPS не достаёт api.telegram.org, поэтому запросы идут через
# свой Cloudflare-воркер: deploy/tg-proxy-worker.js.
TG_BOT_TOKEN=
# Адрес воркера, например https://niaz-tg.<аккаунт>.workers.dev
TG_API_BASE=
# Совпадает с секретом PROXY_SECRET в настройках воркера
TG_PROXY_SECRET=
# Код, которым чат подключается к заявкам: /start КОД. Длинный и случайный:
#   openssl rand -hex 6
TG_JOIN_CODE=

# Письма о заявках: свой сервис отправки (lib/mailer.ts) — письма уходят с
# этого сервера прямо на почтовые узлы получателей, чужой ящик не нужен.
# Пусто — почта выключена, заявки только в CRM и в Telegram.
#
# Чтобы письма не падали в спам, вне кода нужны:
#   — обратная запись (PTR) нашего IP на значение MAIL_HELO (просить у хостера);
#   — в DNS домена отправителя: SPF, DKIM и DMARC (см. deploy/README.md).
# Адрес в письмах. Ящика с таким именем нет и не нужно: приём почты на домене
# не настроен, а в тексте писем сказано, что отвечать не следует.
MAIL_FROM=noreply@niazcrm.ru
# Имя, которым представляемся почтовому узлу. Должно совпадать с PTR.
MAIL_HELO=mail.niazcrm.ru
# Общий ящик отдела, куда идут копии всех заявок. Можно несколько через
# запятую. Личные письма сотрудникам уходят и без этого — по правам роли.
MAIL_TO=

# Подпись DKIM. Ключ лежит на томе рядом с базой, в репозиторий не попадает.
DKIM_KEY_PATH=/app/data-db/dkim-private.pem
DKIM_DOMAIN=niazcrm.ru
DKIM_SELECTOR=niaz

# Только для проверок: слать все письма на указанный узел вместо настоящего.
# На боевом сервере не задавать.
# MAIL_FORCE_MX=
# MAIL_PORT=25
